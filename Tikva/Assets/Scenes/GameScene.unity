--- !u!114 &876507370
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 876507367}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 5ffb24bfd04721549a6d0343e08a61db, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::CrimsonMassDialogue
  axeReward: {fileID: 1381093428}
  textColor: {r: 0.9, g: 0.14, b: 0.13, a: 1}
  lettersPerSecond: 35
  waveAmplitude: 2
  waveSpeed: 4
  waveCharacterPhase: 0.45
  finalLineHold: 1.2
  farewellHold: 2
  lines:
  - phrase: "\u0422\u044B \u043F\u0440\u0438\u0448\u0451\u043B. \u042F \u0416\u0434\u0430\u043B."
    answer: "\u0427\u0442\u043E \u0442\u044B \u0442\u0430\u043A\u043E\u0435?"
  - phrase: "\u041C\u044B \u0441 \u0434\u0440\u0443\u0433\u043E\u0439 \u043F\u043B\u0430\u043D\u0435\u0442\u044B, \u043C\u044B \u043D\u0435 \u0445\u043E\u0442\u0438\u043C \u0442\u0435\u0431\u0435 \u0437\u043B\u0430."
    answer: "\u041A\u0442\u043E \"\u043C\u044B\"?"
  - phrase: "\u0417\u043D\u0430\u0447\u0438\u0442 \u0443 \u043D\u0430\u0441 \u043F\u043E\u043B\u0443\u0447\u0438\u043B\u043E\u0441\u044C."
    answer: "\u0427\u0442\u043E \u043F\u043E\u043B\u0443\u0447\u0438\u043B\u043E\u0441\u044C?"
  - phrase: "\u041F\u0440\u0438\u0442\u0432\u043E\u0440\u0438\u0442\u044C\u0441\u044F \u043B\u044E\u0434\u044C\u043C\u0438. \u0422\u044B \u0434\u043E \u043F\u043E\u0441\u043B\u0435\u0434\u043D\u0435\u0433\u043E \u043D\u0435 \u0437\u0430\u043C\u0435\u0447\u0430\u043B \u0440\u0430\u0437\u043D\u0438\u0446\u044B. \u041C\u044B \u043E\u0447\u0435\u043D\u044C \u0445\u043E\u0442\u0435\u043B\u0438 \u0441\u0442\u0430\u0442\u044C \u043B\u044E\u0434\u044C\u043C\u0438, \u0440\u0430\u0434\u0438 \u044D\u0442\u043E\u0433\u043E \u0432\u0441\u0451 \u0437\u0434\u0435\u0441\u044C \u0438 \u043F\u043E\u0441\u0442\u0440\u043E\u0435\u043D\u043E. \u041D\u0430\u043C \u043D\u0443\u0436\u043D\u043E \u0431\u044B\u043B\u043E \u0443\u0437\u043D\u0430\u0442\u044C, \u043A\u0430\u043A \u0432\u0435\u0434\u0443\u0442 \u0441\u0435\u0431\u044F \u043B\u044E\u0434\u0438."
    answer: "\u0422\u0430\u043A \u043A\u043E\u043C\u0443 \"\u043D\u0430\u043C\"?"
  - phrase: "\u042F \u043D\u0435 \u043E\u0434\u0438\u043D \u0442\u0430\u043A\u043E\u0439. \u0422\u0435\u0431\u044F \u0432\u0441\u0451 \u0432\u0440\u0435\u043C\u044F \u043E\u043A\u0440\u0443\u0436\u0430\u043B\u0438 \u0442\u0430\u043A\u0438\u0435 \u043A\u0430\u043A \u044F. \u041E\u043D\u0438 \u0445\u043E\u0440\u043E\u0448\u043E \u0441\u043F\u0440\u0430\u0432\u0438\u043B\u0438\u0441\u044C."
    answer: "\u0418 \u0447\u0442\u043E \u0442\u0435\u043F\u0435\u0440\u044C?"
  - phrase: "\u0415\u0434\u0438\u043D\u0441\u0442\u0432\u0435\u043D\u043D\u043E\u0435, \u0447\u0442\u043E \u044F \u043D\u0435 \u0432\u0438\u0434\u0435\u043B - \u0447\u0435\u043B\u043E\u0432\u0435\u0447\u0435\u0441\u043A\u0443\u044E \u0441\u043C\u0435\u0440\u0442\u044C."
    answer: "\u0422\u044B \u0445\u043E\u0447\u0435\u0448\u044C \u043C\u0435\u043D\u044F \u0443\u0431\u0438\u0442\u044C?"
  - phrase: "\u041D\u0435\u0442, \u043A \u043D\u0430\u0448\u0435\u043C\u0443 \u0441 \u0442\u043E\u0431\u043E\u0439 \u0441\u0447\u0430\u0441\u0442\u044C\u044E \u0437\u0434\u0435\u0441\u044C \u0435\u0441\u0442\u044C \u0435\u0449\u0451 \u043E\u0434\u0438\u043D \u0447\u0435\u043B\u043E\u0432\u0435\u043A."
    answer: "\u041A\u0442\u043E \u0436\u0435?"
  - phrase: "\u0422\u0432\u043E\u0439 \u0441\u043E\u0441\u0435\u0434. \u0423 \u043F\u043E\u0434\u044A\u0435\u0437\u0434\u0430. \u0414\u0435\u0440\u0436\u0438, \u0442\u044B \u0437\u043D\u0430\u0435\u0448\u044C, \u0447\u0442\u043E \u0441 \u044D\u0442\u0438\u043C \u0434\u0435\u043B\u0430\u0442\u044C."
    answer: 
